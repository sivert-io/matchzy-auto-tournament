# ========================================
# Caddy Configuration for Fragbase
# ========================================
# Internal reverse proxy inside the Docker container (port 3069).
# Two front-end apps are served by Host header:
#   PLAYER_HOST (default play.localhost)  -> /app/public/play   (player app)
#   ORG_HOST    (default admin.localhost) -> /app/public/org    (organizer app)
# A default :3069 block (direct IP/port access) falls back to the player app.
#
# Both hosts share the same backend: /api/*, /socket.io/*, /health -> :3000.
# The external edge (Cloudflare Tunnel / DNS) must map the real play.* and
# admin.* hostnames to this container's :3069.
# ========================================

# --- Player app ---
{$PLAYER_HOST:play.localhost}:3069 {
	reverse_proxy /api/* localhost:3000
	reverse_proxy /socket.io/* localhost:3000
	reverse_proxy /health localhost:3000

	root * /app/public/play
	@notAPI {
		not path /api/* /socket.io/* /health
		file {
			try_files {path} /index.html
		}
	}
	rewrite @notAPI {http.matchers.file.relative}
	file_server
}

# --- Organizer app ---
{$ORG_HOST:admin.localhost}:3069 {
	reverse_proxy /api/* localhost:3000
	reverse_proxy /socket.io/* localhost:3000
	reverse_proxy /health localhost:3000

	root * /app/public/org
	@notAPI {
		not path /api/* /socket.io/* /health
		file {
			try_files {path} /index.html
		}
	}
	rewrite @notAPI {http.matchers.file.relative}
	file_server
}

# --- Default (direct IP/port access) -> player app ---
:3069 {
	reverse_proxy /api/* localhost:3000
	reverse_proxy /socket.io/* localhost:3000
	reverse_proxy /health localhost:3000

	root * /app/public/play
	@notAPI {
		not path /api/* /socket.io/* /health
		file {
			try_files {path} /index.html
		}
	}
	rewrite @notAPI {http.matchers.file.relative}
	file_server
}
