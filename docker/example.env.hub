############################################################
# Fragbase global player hub — copy to docker/env/hub.env
#
#   cp docker/example.env.hub docker/env/hub.env
#   ./scripts/hub-stack.sh up
############################################################

HOST_PORT=3068

ORGANIZATION_ID=hub
ORGANIZATION_NAME=Fragbase Hub
ORGANIZATION_SLUG=hub

# Public URLs
FRONTEND_BASE_URL=https://play.fragbase.gg
API_BASE_URL=https://play.fragbase.gg
PLAYER_PORTAL_URL=https://play.fragbase.gg

PLAYER_HOST=play.fragbase.gg
ORG_HOST=admin.fragbase.gg

########################
# Database (hub-only)
########################
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_NAME=fragbase_hub

########################
# Auth & integrations
########################
SESSION_SECRET=change-me-use-openssl-rand-base64-32
SERVER_TOKEN=change-me-shared-with-cs2-matchzy-plugin

STEAM_API_KEY=

# Hub typically has no Mercado Pago; org stacks handle camp fees
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
